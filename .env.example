# Copy to .env for local overrides (.env is git-ignored). Real environment variables
# take precedence over .env, so Docker/compose/CI can inject per-environment values.
# All variables use the NOTES_ prefix and are validated at startup by pydantic-settings.

# Storage: any SQLAlchemy URL. SQLite by default; e.g. postgresql+psycopg://user:pass@host/db
NOTES_DATABASE_URL=sqlite:///./notes.db

# List endpoints: default and maximum page size
NOTES_DEFAULT_PAGE_SIZE=20
NOTES_MAX_PAGE_SIZE=100

# Comma-separated browser origins allowed to call the API (empty = no cross-origin access)
NOTES_CORS_ORIGINS=
